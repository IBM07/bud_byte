# Copy to .env for local development. NEVER commit .env.
# In production these live in Northflank secret groups (api, worker, crons) and Vercel env (web).

# --- Backend (services/api) ---
BUDBYTE_ENVIRONMENT=development          # development | test | staging | production
BUDBYTE_LOG_LEVEL=INFO
BUDBYTE_DATABASE_URL=postgresql://budbyte:budbyte@localhost:5432/budbyte   # Neon: use the *pooled* URL
BUDBYTE_REDIS_URL=redis://localhost:6379/0
BUDBYTE_RUN_MIGRATIONS_ON_STARTUP=true   # api only; set false on worker/crons

# Telegram (create the bot with @BotFather; dev and prod should be separate bots)
BUDBYTE_TELEGRAM_BOT_TOKEN=
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(32))"
BUDBYTE_TELEGRAM_WEBHOOK_SECRET=
BUDBYTE_TELEGRAM_PATH_SECRET=

# Observability (optional locally)
BUDBYTE_SENTRY_DSN=
BUDBYTE_WEB_ORIGIN=http://localhost:3000

# --- Web (apps/web) ---
API_BASE_URL=http://localhost:8000
